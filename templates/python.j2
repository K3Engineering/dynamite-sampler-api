{% for service in services %}
class {{ service.name }}(BLEService):
{% if service.docstring %}
{{ docstring(service.docstring, '    ') }}
{% endif %}
    UUID = "{{ service.uuid }}"
    advertised = {{ service.advertised }}
{% for char in service.characteristics %}

    {% set bases = [] %}
