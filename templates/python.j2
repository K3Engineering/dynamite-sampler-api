{#-
  Renders the Python BLE API from the resolved IR (see schema/generator.py).

  Render context: enums (EnumDef), structs (StructDef), services (ServiceDef).
  Every type reference is a resolved TypeRef with kind ('primitive', 'enum',
  'struct', 'string', 'bytes'), name, size (bytes; None when variable
  length), signed, and struct_code (None when no struct format code exists,
  e.g. 3-byte ints). Struct fields carry their absolute byte offset, so this
  template contains no type-name dispatch: a whole-characteristic payload is
  just a value unpacked at offset 0.
-#}
{% macro docstring(text, ind) -%}
{{ ind }}"""
{{ ind }}{{ text | replace('\n', '\n' ~ ind) }}
{{ ind }}"""
{%- endmacro %}

{# Python type annotation for a resolved type. #}
{% macro py_type(t) -%}
{% if t.kind == 'primitive' %}int{% elif t.kind == 'string' %}str{% elif t.kind == 'bytes' %}bytes{% else %}{{ t.name }}{% endif %}
{%- endmacro %}

{# Slice of `data` covering type t starting at byte offset `off`.
   Variable-length types run to the end of the buffer. #}
{% macro data_slice(t, off) -%}
{%- if t.size is none -%}
{%- if off is number and off == 0 -%}data{%- else -%}data[{{ off }}:]{%- endif -%}
{%- elif off is number -%}
data[{{ off }}:{{ off + t.size }}]
{%- else -%}
data[{{ off }}:{{ off }} + {{ t.size }}]
{%- endif -%}
{%- endmacro %}

{# Expression that unpacks one value of resolved type t from `data` at byte
   offset `off`. Used for struct fields (absolute offsets) and for whole
   characteristic payloads (offset 0) alike. #}
{% macro unpack_expr(t, off) -%}
{%- if t.kind == 'primitive' or t.kind == 'enum' -%}
{%- if t.struct_code -%}
{%- set raw = "struct.unpack_from('<" ~ t.struct_code ~ "', data, " ~ off ~ ")[0]" -%}
{%- else -%}
{%- set raw = "int.from_bytes(" ~ data_slice(t, off) ~ ", byteorder='little', signed=" ~ t.signed ~ ")" -%}
{%- endif -%}
{%- if t.kind == 'enum' -%}{{ t.name }}({{ raw }}){%- else -%}{{ raw }}{%- endif -%}
{%- elif t.kind == 'string' -%}
{{ data_slice(t, off) }}.decode('utf-8')
{%- elif t.kind == 'bytes' -%}
{{ data_slice(t, off) }}
{%- else -%}
{{ t.name }}.unpack({{ data_slice(t, off) }})
{%- endif -%}
{%- endmacro %}

{# Statement that unpacks one struct field (scalar or repeat-to-end list). #}
{% macro unpack_field_stmt(field) -%}
{% if field.is_list %}
_{{ field.name }} = [{{ unpack_expr(field.type, '_i') }} for _i in range({{ field.offset }}, len(data), {{ field.type.size }})]
{%- else %}
_{{ field.name }} = {{ unpack_expr(field.type, field.offset) }}
{%- endif %}
{%- endmacro %}

{# Statement that packs a whole-characteristic payload from `data`. #}
{% macro pack_payload_stmt(t) -%}
{% if t.kind == 'primitive' and t.struct_code %}
return struct.pack('<{{ t.struct_code }}', data)
{%- elif t.kind == 'primitive' %}
return data.to_bytes({{ t.size }}, byteorder='little', signed={{ t.signed }})
{%- elif t.kind == 'enum' and t.struct_code %}
return struct.pack('<{{ t.struct_code }}', data.value)
{%- elif t.kind == 'enum' %}
return int(data).to_bytes({{ t.size }}, byteorder='little')
{%- elif t.kind == 'string' %}
return data.encode('utf-8')
{%- elif t.kind == 'bytes' %}
return data
{%- else %}
raise NotImplementedError("Packing struct payloads is not yet implemented")
{%- endif %}
{%- endmacro %}

